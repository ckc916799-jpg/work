{
  "manifest_version": 3,
  "name": "抖音视频入表 · Video Sheet",
  "short_name": "抖音视频入表",
  "version": "1.2.4",
  "description": "悬浮复制抖音视频数据与高赞评论到 WPS，保留原有 Excel 入表工作台。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "activeTab", "downloads", "clipboardWrite"],
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://v.douyin.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "打开抖音视频入表", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "content_scripts": [
    {"matches": ["https://www.douyin.com/*"], "js": ["floating-panel.js", "bridge.js"], "run_at": "document_start", "world": "ISOLATED"},
    {"matches": ["https://www.douyin.com/*"], "js": ["observer.js"], "run_at": "document_start", "world": "MAIN"}
  ],
  "web_accessible_resources": [
    {"resources": ["clipboard.mjs", "core.mjs"], "matches": ["https://www.douyin.com/*"]}
  ]
}

